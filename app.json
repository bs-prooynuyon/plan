{
  "expo": {
    "name": "Planım",
    "slug": "planim",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/planim-icon.png",
    "scheme": "planim",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.planim.lgs",
      "versionCode": 1,
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundColor": "#F4F4F5"
      }
    },
    "web": {
      "favicon": "./assets/images/planim-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#2F6FDE"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "spotifyClientId": ""
    }
  }
}